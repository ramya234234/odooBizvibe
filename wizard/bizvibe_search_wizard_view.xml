<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bizvibe_search_wizard_form" model="ir.ui.view">
        <field name="name">bizvibe.search.wizard.form</field>
        <field name="model">bizvibe.search.wizard</field>
        <field name="arch" type="xml">
            <form string="BizVibe Smart AI Search">
                <sheet>
                    <group>
                        <group>
                            <field name="query" placeholder="e.g. 'Software companies in Mumbai'"/>
                        </group>
                        <group>
                            <button name="action_search" string="Search" type="object" class="btn-primary"/>
                        </group>
                    </group>
                    <group string="Results">
                        <field name="result_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="selected"/>
                                <field name="name"/>
                                <field name="industry"/>
                                <field name="location"/>
                                <field name="website"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import_contacts" string="Import to Contacts" type="object" class="btn-primary"/>
                    <button name="action_import_leads" string="Import to Leads" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bizvibe_search_wizard" model="ir.actions.act_window">
        <field name="name">BizVibe Smart Search (Legacy)</field>
        <field name="res_model">bizvibe.search.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>