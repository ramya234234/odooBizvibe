<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bizvibe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add at the bottom of the settings page -->
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="BizVibe" data-key="bizvibe_smart_ai">
                    <h2>BizVibe Smart AI</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="bizvibe_api_key"/>
                                <div class="text-muted">
                                    Get your API Key from the BizVibe dashboard.
                                </div>
                                <field name="bizvibe_api_key" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="bizvibe_api_endpoint"/>
                                <div class="text-muted">
                                    BizVibe API endpoint URL.
                                </div>
                                <field name="bizvibe_api_endpoint"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="bizvibe_user_id"/>
                                <div class="text-muted">
                                    Default User ID for API calls.
                                </div>
                                <field name="bizvibe_user_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>