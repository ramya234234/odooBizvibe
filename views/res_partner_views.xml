<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_bizvibe" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.bizvibe</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_bizvibe_enrich" 
                            string="Enrich with BizVibe" 
                            type="object" 
                            class="btn btn-primary" 
                            icon="fa-magic"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>