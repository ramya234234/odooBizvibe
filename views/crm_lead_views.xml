        <field name="name">crm.lead.form.inherit.bizvibe</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_bizvibe_enrich_lead" 
                        string="Sync with Bizvibe" 
                        type="object" 
                        class="btn btn-primary" 
                        icon="fa-line-chart"/>
            </xpath>
<!-- Ensure description field renders HTML -->
             
        </field>
    </record>
</odoo>